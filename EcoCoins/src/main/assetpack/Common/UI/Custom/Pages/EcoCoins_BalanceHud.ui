Group #RightBalancePanel {
  Anchor: (Right: 0, Bottom: 152, Width: 190, Height: 28);
  Background: (Color: #1a1e2dd8);
  Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);
  LayoutMode: Left;

  Label #RightCurrencyName {
    Text: "EcoCoin";
    Style: (
      FontSize: 14,
      TextColor: #888888,
      VerticalAlignment: Center
    );
    Padding: (Right: 8);
    Anchor: (Vertical: 0);
  }

  Label #RightBalanceAmount {
    Text: "0.00";
    Style: (
      FontSize: 16,
      TextColor: #ffffff,
      VerticalAlignment: Center
    );
    Anchor: (Vertical: 0);
  }
}

Group #LeftBalancePanel {
  Anchor: (Left: 0, Bottom: 152, Width: 190, Height: 28);
  Background: (Color: #1a1e2dd8);
  Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);
  LayoutMode: Left;
  Visibility: Collapsed;

  Label #LeftCurrencyName {
    Text: "EcoCoin";
    Style: (
      FontSize: 14,
      TextColor: #888888,
      VerticalAlignment: Center
    );
    Padding: (Right: 8);
    Anchor: (Vertical: 0);
  }

  Label #LeftBalanceAmount {
    Text: "0.00";
    Style: (
      FontSize: 16,
      TextColor: #ffffff,
      VerticalAlignment: Center
    );
    Anchor: (Vertical: 0);
  }
}
